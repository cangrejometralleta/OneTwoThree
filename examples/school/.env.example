# Copy to .env beside the Program you Run. run.sh Loads it when Present.
# A Variable already Exported Wins; this File never Overrides your Shell.
# .env is Ignored by git. This File is the Contract, and it is Committed.

# Required. No Default Exists, and Startup Stops without them.
APP_ENV=development
TOKEN_SECRET=replace-with-a-random-32-byte-secret

# Optional Overrides; the Defaults shown below Apply when unset.
# They Live in config/school.defaults.json and the Environment File,
# so this Block Repeats them for Reading, never for Loading.
# SCHOOL_PORT=8080
# SCHOOL_TOKEN_LIFE_SECONDS=600
# SERVER=stdlib

# Development Reads school.db; Production Reads school.production.db.
# SCHOOL_DATABASE_PATH=school.db
